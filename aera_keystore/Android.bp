// SPDX-License-Identifier: Apache-2.0
// Recovery entrypoint; the crypto implementation remains the pinned libkeystore2.
rust_binary {
    name: "aera_keystore2",
    srcs: ["main.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libandroid_logger",
        "libbinder_rs",
        "liblog_rust",
        "libkeystore2",
        "liblegacykeystore-rust",
        "librusqlite",
    ],
    required: ["keystore_cli_v2"],
}
